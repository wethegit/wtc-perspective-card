{
  "name": "wtc-perspective-card-workspace",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter wtc-perspective-card build",
    "build:demo": "pnpm --filter demo build",
    "preview": "pnpm --filter demo preview",
    "document": "pnpm --filter wtc-perspective-card document",
    "format": "prettier --write --ignore-unknown \"packages/wtc-perspective-card/src/**/*.{js,scss}\" \"demo/*.{js,scss}\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "prettier": "~3.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
